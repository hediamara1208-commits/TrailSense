# 1Password secret references (safe to commit: no secret values here).
# Usage: op run --env-file=.env.1password -- python scripts/run_api.py
# The 1Password CLI resolves each op:// reference at run time and passes it as an environment variable.
TYPESAFE_API_KEY=op://TrailSense/Jev/credential
